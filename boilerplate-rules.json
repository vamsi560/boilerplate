{
  "rules": [
    {
      "name": "Missing Required Parameters",
      "pattern": "provider\\s+\"aws\"\\s*\\{\\s*#.*",
      "category": "Configuration",
      "message": "Provider block is missing required parameters like region."
    },
    {
      "name": "Hardcoded Bucket Name",
      "pattern": "bucket\\s*=\\s*\"[^\"]+\"",
      "category": "Best Practices",
      "message": "Bucket name should be parameterized."
    },
    {
      "name": "Hardcoded AMI ID",
      "pattern": "ami\\s*=\\s*\"ami-[^\"]+\"",
      "category": "Best Practices",
      "message": "AMI ID should be parameterized."
    },
    {
      "name": "Improper Tag Naming",
      "pattern": "tags\\s*=\\s*\\{\\s*Name\\s*=\\s*\"[^\"]+\"",
      "category": "Best Practices",
      "message": "Tags should follow naming conventions."
    },
    {
      "name": "Missing Security Group Configuration",
      "pattern": "resource\\s+\"aws_instance\"\\s+\"example\"\\s*\\{\\s*[^}]*\\n\\s*# Violations: Missing proper security group configuration",
      "category": "Configuration",
      "message": "Security group configuration is missing."
    }
  ]
}
